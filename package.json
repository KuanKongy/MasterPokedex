{
  "name": "masterpokedex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@masterpokedex/api",
    "dev:web": "npm run dev --workspace=@masterpokedex/web",
    "build": "npm run build --workspace=@masterpokedex/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "deploy:web": "npm run deploy --workspace=@masterpokedex/web",
    "db:generate": "npm run generate --workspace=@masterpokedex/db",
    "db:migrate": "npm run migrate --workspace=@masterpokedex/db",
    "db:push": "npm run push --workspace=@masterpokedex/db",
    "db:studio": "npm run studio --workspace=@masterpokedex/db",
    "db:seed": "npm run seed --workspace=@masterpokedex/db",
    "db:seed:auth": "npm run seed:auth --workspace=@masterpokedex/db",
    "db:seed:demo": "npm run seed:demo --workspace=@masterpokedex/db",
    "db:verify": "npm run verify --workspace=@masterpokedex/db"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.5.3"
  }
}
